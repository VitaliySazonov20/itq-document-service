<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.30.xsd">

    <changeSet id="04-add-document-indexes" author="vitaliy">
        <createIndex tableName="documents" indexName="idx_documents_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="documents" indexName="idx_documents_created_at">
            <column name="created_at"/>
        </createIndex>
        <createIndex tableName="documents" indexName="idx_documents_author">
            <column name="author"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>